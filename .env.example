# Anthropic API key powers the natural-language extraction layer.
# Without it the agent falls back to deterministic parsing only,
# which handles clean inputs but misses much of the messy phrasing.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PAYMENT_API_BASE_URL=https://se-payment-verification-api.service.external.usea2.aws.prodigaltech.com
PAYMENT_AGENT_MODEL=claude-sonnet-4-6
PAYMENT_AGENT_LOG_LEVEL=INFO
